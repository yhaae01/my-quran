<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome silhouette of the app launcher logo (circle, star, open book).
  Android tints notification small icons, so the artwork uses a single white
  fill with transparent gaps. Used instead of the default bell icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Circle around the logo. -->
    <path
        android:pathData="M12,2.6 A9.4,9.4 0 1,1 12,21.4 A9.4,9.4 0 1,1 12,2.6 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.3"
        android:fillColor="#00000000" />
    <!-- Four-point star above the book. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3.2 L12.8,5.3 L14.9,6.1 L12.8,6.9 L12,9 L11.2,6.9 L9.1,6.1 L11.2,5.3 Z" />
    <!-- Open book: two pages with a transparent spine. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.6,10.4 C9.5,9.45 7.3,9.3 5.9,9.55 L5.9,13.95 C7.3,13.7 9.5,13.85 11.6,14.75 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.4,10.4 C14.5,9.45 16.7,9.3 18.1,9.55 L18.1,13.95 C16.7,13.7 14.5,13.85 12.4,14.75 Z" />
</vector>
